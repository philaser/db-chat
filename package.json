{
  "name": "db-chat",
  "version": "0.1.0",
  "description": "Ask questions of your own databases through a hosted web workspace.",
  "author": "DB Chat contributors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "npm run web:client:build && npm run web:server:build",
    "start": "node --env-file-if-exists=.env dist-web-server/server/server.js",
    "web:client:build": "vite build",
    "web:server:build": "node scripts/build-server.mjs",
    "web:build": "npm run build",
    "web:start": "npm start",
    "web:dev": "npm run dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/build-desktop.mjs --development && electron dist-desktop",
    "desktop:package": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "pretest": "npm run rebuild:sqlite:node",
    "rebuild:sqlite:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:databases": "npm run web:server:build && node scripts/integration/run.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web-server.json --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "eval:chat": "npm run web:server:build && node --env-file-if-exists=.env scripts/evaluate-chat.mjs"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.1.2",
    "better-sqlite3": "^12.4.6",
    "lucide-react": "^0.561.0",
    "mongodb": "^7.2.0",
    "mysql2": "^3.22.3",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "esbuild": "0.27.7"
  }
}
