# Hosted app: browser and Node backend share this public origin.
DBCHAT_WEB_ALLOWED_ORIGIN=http://localhost:5173
DBCHAT_STORAGE_MODE=supabase
DBCHAT_WEB_AUTH_MODE=app

# Supabase project credentials. Only the publishable key is public;
# the service role and application encryption key must stay server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random key with at least 32 characters. Back it up separately.
DBCHAT_WEB_SECRET_KEY=

# Server-managed inference. Never put provider secrets in VITE_* variables.
DBCHAT_WEB_OPENROUTER_API_KEY=
# Every managed account uses this model; only personal providers unlock selection.
DBCHAT_WEB_MODEL=google/gemini-2.5-flash

# Runtime budgets.
DBCHAT_WEB_SESSION_TTL_MS=1800000
DBCHAT_WEB_SESSION_ABSOLUTE_TTL_MS=2592000000
DBCHAT_WEB_MAX_SQLITE_UPLOAD_BYTES=52428800
DBCHAT_WEB_MAX_ACTIVE_TURNS_PER_USER=2
DBCHAT_WEB_MAX_ACTIVE_TURNS=16
# Durable accepted managed turns per UTC day. Failed/cancelled attempts count;
# idempotent retries and personal-provider turns do not. These are not USD caps.
DBCHAT_WEB_MANAGED_TURNS_PER_ACCOUNT_PER_DAY=100
DBCHAT_WEB_MANAGED_TURNS_PER_DAY=1000
# SQLite upload admission: failed uploads also consume the reserved allowance.
DBCHAT_WEB_SQLITE_UPLOADS_PER_ACCOUNT_PER_DAY=10
DBCHAT_WEB_SQLITE_UPLOADS_PER_DAY=100
DBCHAT_WEB_SQLITE_UPLOAD_BYTES_PER_ACCOUNT_PER_DAY=262144000
DBCHAT_WEB_SQLITE_UPLOAD_BYTES_PER_DAY=1073741824
DBCHAT_WEB_MAX_CONCURRENT_UPLOADS=2
# Leave at 0 unless the service is reachable only through a known proxy chain.
# Set the exact number of trusted proxy hops; never trust arbitrary client XFF.
DBCHAT_WEB_TRUSTED_PROXY_HOPS=0
DBCHAT_WEB_SHUTDOWN_GRACE_MS=25000
DBCHAT_WEB_MAX_CHAT_BODY_BYTES=16777216
DBCHAT_WEB_MAX_RESULT_ROWS=100
DBCHAT_WEB_MAX_RESULT_BYTES=1048576
# Downloads run independently of chat previews; exceeding a limit fails the
# whole export rather than offering a silently incomplete file.
DBCHAT_EXPORT_MAX_ROWS=1000000
DBCHAT_EXPORT_MAX_BYTES=104857600
DBCHAT_EXPORT_TIMEOUT_MS=300000

# Optional exact destination restriction, comma separated. Customers bring their
# own reachable databases; the server separately rejects private/internal targets.
# Production network egress controls must enforce the same boundary.
DBCHAT_WEB_ALLOWED_DATABASE_HOSTS=

# Optional desktop shell only. The hosted web app never uses Electron.
# HTTPS for distributions; loopback HTTP allowed by desktop:dev only.
DBCHAT_DESKTOP_URL=

# Per-process driver/SQLite child admission; tune with measured memory headroom.
DBCHAT_WEB_MAX_DATABASE_OPERATIONS=2

# Concurrent API handlers/responses. Health remains available at capacity.
DBCHAT_WEB_MAX_CONCURRENT_REQUESTS=8
